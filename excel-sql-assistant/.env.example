# .env.example — Excel SQL Assistant Environment Configuration

# Backend Proxy URL (set to your deployed Cloudflare Worker or Azure Function)
# Leave blank to use /api/ask relative path or default mock mode
VITE_PROXY_URL=https://excel-sql-proxy.yourname.workers.dev/api/ask

# Optional Secret Bearer Token for Tenant/User Authorization
VITE_PROXY_AUTH_TOKEN=your-secret-proxy-auth-token-here

# Force Mock AI mode for offline testing without calling Claude API (true | false)
VITE_MOCK_AI=true
